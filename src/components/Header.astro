---
import BookLink from "./BookLink.astro";

const navLinks = [
	{ href: "/#subjects", label: "Subjects" },
	{ href: "/#approach", label: "Approach" },
	{ href: "/online-maths-tutor-for-parents/", label: "For parents" },
	{ href: "/#pricing", label: "Pricing" },
	{ href: "/#reviews", label: "Reviews" },
	{ href: "/#faq", label: "FAQ" },
];
---

<header class="site-head" id="head">
	<div class="wrap head-row">
		<a href="/" class="brand"><span class="seal"></span> First Principles</a>
		<nav class="nav">
			{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<div class="head-cta">
			<a href="/#pricing" class="btn ghost">View pricing</a>
			<BookLink class="btn primary js-book">Book a free intro <span class="arr">&rarr;</span></BookLink>
			<button class="menu-btn" id="menuBtn" type="button" aria-label="Menu" aria-controls="mNav" aria-expanded="false"><i></i><i></i><i></i></button>
		</div>
	</div>
	<div class="m-nav" id="mNav">
		<div class="wrap">
			{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			<BookLink class="js-book">Book a free intro</BookLink>
		</div>
	</div>
</header>

<script>
	const head = document.getElementById("head")!;
	const onScroll = () => head.classList.toggle("scrolled", window.scrollY > 8);
	onScroll();
	window.addEventListener("scroll", onScroll, { passive: true });

	const menuBtn = document.getElementById("menuBtn")!;
	const mNav = document.getElementById("mNav")!;
	const setMenuOpen = (isOpen: boolean) => {
		menuBtn.classList.toggle("open", isOpen);
		mNav.classList.toggle("open", isOpen);
		menuBtn.setAttribute("aria-expanded", String(isOpen));
	};

	menuBtn.addEventListener("click", () => {
		setMenuOpen(!mNav.classList.contains("open"));
	});
	mNav.querySelectorAll("a").forEach((a) =>
		a.addEventListener("click", () => {
			setMenuOpen(false);
		}),
	);
</script>
