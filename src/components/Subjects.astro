---
interface Subject {
	tag: string;
	title: string;
	body: string;
	href: string;
}

const subjects: Subject[] = [
	{
		tag: "AA · AI · SL · HL",
		title: "IB Mathematics",
		body: "Analysis & Approaches and Applications & Interpretation, at both Standard and Higher Level.",
		href: "/ib-maths-tutor/",
	},
	{
		tag: "IGCSE · AS · A-Level",
		title: "Cambridge & A-Level",
		body: "IGCSE, AS and A-Level mathematics across the major examination boards.",
		href: "/a-level-maths-tutor/",
	},
	{
		tag: "A-Level Further",
		title: "Further Mathematics",
		body: "The harder material — taught carefully, at the pace it genuinely needs.",
		href: "/further-maths-tutor/",
	},
	{
		tag: "NCEA L1–3",
		title: "NCEA Mathematics",
		body: "Levels 1 to 3, including the calculus and statistics achievement standards.",
		href: "/ncea-maths-tutor/",
	},
	{
		tag: "AP · SAT",
		title: "US & International",
		body: "AP Calculus, SAT maths, and general high-school mathematics taught in English.",
		href: "/ap-calculus-sat-maths-tutor/",
	},
	{
		tag: "Parent support",
		title: "Students rebuilding confidence",
		body: "Calm, structured support for students who feel stuck, anxious or behind.",
		href: "/online-maths-tutor-for-parents/",
	},
];
---

<section id="subjects">
	<div class="wrap">
		<div class="sec-head reveal">
			<span class="eyebrow">What I teach</span>
			<h2 class="display">Tutoring options</h2>
			<p class="lede">Mathematics first — with economics and finance as supporting subjects.</p>
		</div>
		<div class="subj-grid">
			{
				subjects.map((subject) => {
					return (
						<a href={subject.href} class="subj-card reveal">
							<div class="tag">{subject.tag}</div>
							<h3>{subject.title}</h3>
							<p>{subject.body}</p>
							<span class="more">
								Explore <span class="arr">&rarr;</span>
							</span>
						</a>
					);
				})
			}
		</div>
	</div>
</section>
